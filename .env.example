MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_THIS_TO_YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=TravelDB
FLASK_SECRET_KEY=change-this-to-a-long-random-secret

# MongoDB Atlas Configuration (DA3)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=TravelDB_Documents

# Optional Live Traffic API Key
TOMTOM_API_KEY=
